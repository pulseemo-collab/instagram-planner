# Supabase — leave unset to run in demo mode (local IndexedDB persistence).
# Find these in your Supabase project: Settings → API.
#
# IMPORTANT: the app's mode (demo vs live) is frozen when you run `next build`.
# After adding, changing, or removing these values, ALWAYS rebuild
# (`npm run build`) before `npm start` — a stale build ignores runtime-only
# changes by design, so the server and browser can never disagree about the mode.

# Project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=

# anon/public API key (safe to expose to the browser; protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY, bypasses RLS. Never prefix with NEXT_PUBLIC_.
# Not used by the app or by any script in this repo: leave it empty, and never
# add it to Vercel.
SUPABASE_SERVICE_ROLE_KEY=
